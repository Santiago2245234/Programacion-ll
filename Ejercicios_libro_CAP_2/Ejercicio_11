nombre = input("¿Cuál es tu nombre? ")
# Convertimos la entrada directamente a un número entero (int)
edad = int(input("¿Cuántos años tienes? "))

# Ahora sí se pueden sumar ambos números enteros
edad_en_10 = edad + 10

# Se corrige el paréntesis de cierre en el print()
print(f"{nombre}, en 10 años tendrás {edad_en_10} años.")
